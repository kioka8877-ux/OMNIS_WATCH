{
  "version": "2.0",
  "emotion_mode": "WHOLESOME",
  "video": {
    "fps": 30,
    "width": 1080,
    "height": 1920
  },
  "text_defaults": {
    "font": "Anton, Arial Black, sans-serif",
    "size": 96,
    "color": "#FFFFFF",
    "stroke_color": "#000000",
    "stroke_width": 4,
    "position": "bottom",
    "animation": "word_by_word"
  },
  "zoom": {
    "min_scale": 1.0,
    "max_scale": 1.3,
    "on_strong_word": true
  },
  "color_preset": "warm_vibrant",
  "color_css_filter": "contrast(1.2) saturate(1.15) brightness(1.05) hue-rotate(3deg)",
  "enhance_4k": true,
  "sharpening": 80,
  "vignette": 0.25,
  "grain_intensity": 0.2,
  "sfx_defaults": {
    "types": [
      "keyboard",
      "whoosh",
      "pop",
      "ding"
    ],
    "volume": 0.3,
    "on_strong_word": true
  }
}