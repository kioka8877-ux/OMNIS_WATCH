{
  "version": "2.0",
  "emotion_mode": "MOTIVATION",
  "narrative_arc": "setup → context → climax → emotional_peak → action → resolution",
  "video": {
    "fps": 30,
    "width": 1080,
    "height": 1920
  },
  "text_defaults": {
    "font": "Anton, Arial Black, sans-serif",
    "size": 28,
    "color": "#FFD700",
    "stroke_color": "#000000",
    "stroke_width": 5,
    "shadow": "2px 4px 8px rgba(0,0,0,0.9)",
    "position": "bottom",
    "letter_spacing": "0em",
    "glow_intensity": 0,
    "depth_3d": 0,
    "animation": "word_by_word"
  },
  "zoom": {
    "min_scale": 1,
    "max_scale": 1.3,
    "on_strong_word": true
  },
  "color_preset": "argent",
  "color_css_filter": "contrast(1.3) saturate(0.15) brightness(0.85) grayscale(0.8)",
  "enhance_4k": true,
  "sharpening": 45,
  "vignette": 0.25,
  "grain_intensity": 0.2,
  "sfx_defaults": {
    "types": [
      "keyboard",
      "whoosh",
      "pop",
      "ding"
    ],
    "volume": 0.3,
    "on_strong_word": true
  }
}